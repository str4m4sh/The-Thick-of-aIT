# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# OPTION 1: Local Ollama (Default for free/offline running on 8GB RAM)
# ==============================================================================
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
CHAT_MODEL=llama3.2:3b
CODE_MODEL=qwen2.5-coder:3b

# ==============================================================================
# OPTION 2: Cloud API (e.g., OpenRouter, Groq, OpenAI, DeepSeek)
# Uncomment below if you want lightning-fast, high-end models without CPU strain
# ==============================================================================
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your-key-here
# CHAT_MODEL=meta-llama/llama-3.2-3b-instruct
# CODE_MODEL=qwen/qwen-2.5-coder-7b-instruct
